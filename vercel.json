{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/discord",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ],
  "rewrites": [
    { "source": "/api/upload", "destination": "/api/upload" },
    { "source": "/api/admin", "destination": "/api/admin" },
    { "source": "/api/login", "destination": "/api/login" },
    { "source": "/api/data", "destination": "/api/data" },
    { "source": "/api/data/:slug*", "destination": "/api/data-file" },
    { "source": "/admin", "destination": "/public/index.html" },
    { "source": "/admin/:path*", "destination": "/public/index.html" }
  ]
}
